<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hourly health check for the unattended loop: heartbeat freshness, host-vs-venue clock skew and
      offline reproduction of the last cycle (M-011).  Read-only: it never writes to the venue.
      Runs at :10 past the hour, after the loop's own cycle has settled.
      Install (operator action):
        cp deploy/com.starquant.check.plist /Users/you/Library/LaunchAgents/
        launchctl load -w /Users/you/Library/LaunchAgents/com.starquant.check.plist
    -->
    <key>Label</key>
    <string>com.starquant.check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/you/starquant/deploy/run_check.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/you/starquant</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/you/Library/Application Support/starquant/check.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/you/Library/Application Support/starquant/check.stderr.log</string>
</dict>
</plist>
